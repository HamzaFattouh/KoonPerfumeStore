{
  "name": "koon-perfume-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm --prefix frontend run build && node -e \"const fs=require('fs'); fs.cpSync('frontend/dist', 'dist', {recursive:true}); fs.cpSync('frontend/dist', 'build', {recursive:true});\"",
    "start:backend": "npm --prefix backend start",
    "start:frontend": "npm --prefix frontend run preview",
    "start": "npm --prefix backend start",
    "seed": "npm --prefix backend run seed"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0"
  }
}
